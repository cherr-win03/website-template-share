{
  "name": "website-template-share",
  "private": true,
  "type": "module",
  "description": "Cloudflare Workers 위의 웹사이트 시작 템플릿",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "setup": "node scripts/setup-local.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:seed:local": "node scripts/seed-local.mjs",
    "dev": "node scripts/dev.mjs",
    "test": "node --test --test-concurrency=4 tests/*.test.mjs",
    "test:browser": "playwright test",
    "check:d1": "node scripts/check-d1.mjs",
    "check:a11y": "node scripts/a11y-audit.mjs",
    "version:stamp": "node scripts/version-stamp.mjs",
    "deploy:check": "node scripts/deploy-guard.mjs check",
    "deploy:release": "node scripts/deploy-guard.mjs release",
    "deploy:verify": "node scripts/post-deploy-check.mjs",
    "deploy:rollback": "node scripts/deploy-rollback.mjs"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20261006.1": true
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "1.65.0",
    "jsdom": "30.1.1",
    "wrangler": "4.148.0"
  }
}
